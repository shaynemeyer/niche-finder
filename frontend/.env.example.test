  # Test environment for Playwright E2E runs.
  #
  #   cp .env.test.example .env.test
  #
  # .env.test is gitignored. Everything here is throwaway — never reuse
  # real credentials or a real secret in this file.

  # Same database as development, but a separate Postgres SCHEMA.
  # The ?schema=test parameter is what keeps E2E rows out of your dev
  # data: Postgres schemas are isolated namespaces within one database,
  # so `prisma migrate deploy` creates the tables under `test.*` and
  # leaves `public.*` untouched. No second database to create.
  #
  # Copy your dev DATABASE_URL and append ?schema=test
  DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/nichefinder?schema=test"

  # NextAuth signing secret. Any non-empty value works for tests.
  # Generate one with: openssl rand -base64 32
  AUTH_SECRET="test-secret-not-for-production"

  # Base URL Playwright's webServer binds to.
  NEXTAUTH_URL="http://localhost:3000"

  # Seeded accounts. prisma/seed.ts requires ALL FOUR and throws if any
  # is missing. The E2E specs sign in as these users, so the values must
  # match what the specs expect.
  ADMIN_EMAIL="admin@test.local"
  ADMIN_PASSWORD="add-password-here"
  DEFAULT_USER_EMAIL="user@test.local"
  DEFAULT_USER_PASSWORD="add-password-here"